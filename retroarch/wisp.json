{
  "$schema": "../wisp.schema.json",
  "schemaVersion": 1,
  "slug": "retroarch",
  "version": "1.0.0",
  "name": "RetroArch",
  "description": "t:description",
  "icon": "icon.svg",
  "container": {
    "image": "lscr.io/linuxserver/retroarch:latest",
    "env": { "TZ": "Europe/Paris" }
  },
  "volumes": [
    {
      "id": "config",
      "label": "t:volumes.config.label",
      "scope": "perUser",
      "hostPath": "retroarch",
      "containerPath": "/config",
      "mode": "rw"
    },
    {
      "id": "roms",
      "label": "t:volumes.roms.label",
      "scope": "shared",
      "hostPath": "/data/shared/roms",
      "containerPath": "/config/.config/retroarch/roms",
      "mode": "ro"
    },
    {
      "id": "assets-cores",
      "label": "t:volumes.assets-cores.label",
      "scope": "shared",
      "hostPath": "/data/shared/retroarch/cores",
      "containerPath": "/config/.config/retroarch/cores",
      "mode": "rw"
    },
    {
      "id": "assets-autoconfig",
      "label": "t:volumes.assets-autoconfig.label",
      "scope": "shared",
      "hostPath": "/data/shared/retroarch/autoconfig",
      "containerPath": "/config/.config/retroarch/autoconfig",
      "mode": "rw"
    },
    {
      "id": "assets-config",
      "label": "t:volumes.assets-config.label",
      "scope": "shared",
      "hostPath": "/data/shared/retroarch/config",
      "containerPath": "/config/.config/retroarch/config",
      "mode": "rw"
    },
    {
      "id": "assets-system",
      "label": "t:volumes.assets-system.label",
      "scope": "shared",
      "hostPath": "/data/shared/retroarch/system",
      "containerPath": "/config/.config/retroarch/system",
      "mode": "rw"
    }
  ]
}
