{
  "$schema": "../wisp.schema.json",
  "schemaVersion": 1,
  "slug": "firefox",
  "version": "1.0.0",
  "name": "Firefox",
  "description": "t:description",
  "icon": "icon.svg",
  "container": {
    "image": "ghcr.io/wisp-hq/firefox:latest",
    "env": { "TZ": "Europe/Paris" }
  },
  "volumes": [
    {
      "id": "profile",
      "label": "t:volumes.profile.label",
      "scope": "perUser",
      "hostPath": "firefox",
      "containerPath": "/config",
      "mode": "rw"
    }
  ]
}
