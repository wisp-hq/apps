{
  "$schema": "../app.schema.json",
  "schemaVersion": 1,
  "slug": "firefox",
  "version": "1.0.0",
  "name": "Firefox",
  "description": "t:description",
  "icon": "icon.svg",
  "category": "browser",
  "container": {
    "image": "lscr.io/linuxserver/firefox:latest",
    "env": {
      "PIXELFLUX_WAYLAND": "true"
    }
  },
  "volumes": [
    {
      "id": "profile",
      "label": "t:volumes.profile.label",
      "scope": "perUser",
      "hostPath": "firefox",
      "containerPath": "/config",
      "mode": "rw"
    }
  ]
}
