{
  "$schema": "../wisp.schema.json",
  "schemaVersion": 1,
  "slug": "steam",
  "version": "1.0.0",
  "name": "Steam",
  "description": "t:description",
  "icon": "icon.svg",
  "container": {
    "image": "lscr.io/linuxserver/steam:latest",
    "env": { "TZ": "Europe/Paris" }
  },
  "volumes": [
    {
      "id": "config",
      "label": "t:volumes.config.label",
      "scope": "perUser",
      "hostPath": "steam",
      "containerPath": "/config",
      "mode": "rw"
    },
    {
      "id": "library-common",
      "label": "t:volumes.library-common.label",
      "scope": "shared",
      "hostPath": "/data/shared/SteamLibrary/common",
      "containerPath": "/config/.local/share/Steam/steamapps/common",
      "mode": "rw"
    },
    {
      "id": "library-shadercache",
      "label": "t:volumes.library-shadercache.label",
      "scope": "shared",
      "hostPath": "/data/shared/SteamLibrary/shadercache",
      "containerPath": "/config/.local/share/Steam/steamapps/shadercache",
      "mode": "rw"
    },
    {
      "id": "library-workshop",
      "label": "t:volumes.library-workshop.label",
      "scope": "shared",
      "hostPath": "/data/shared/SteamLibrary/workshop",
      "containerPath": "/config/.local/share/Steam/steamapps/workshop",
      "mode": "rw"
    }
  ],
  "features": {
    "shortcuts": {
      "provider": "steam",
      "containerPath": "/config/.local/share/Steam/steamapps"
    }
  }
}
