{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/wisp-hq/apps/main/wisp.schema.json",
  "title": "Wisp app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "slug", "version", "name", "icon", "container"],
  "properties": {
    "$schema": { "type": "string" },

    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "description": "Manifest format version. Bumped only on breaking changes."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Stable identifier. Must match the parent directory name."
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "description": "Semver of this manifest. Bumped on every content change. Used to detect updates."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name (untranslated; brand names stay as-is)."
    },
    "description": {
      "$ref": "#/$defs/translatableString",
      "description": "Short blurb shown in the catalog."
    },
    "icon": {
      "type": "string",
      "minLength": 1,
      "description": "Icon file path relative to wisp.json (e.g. 'icon.png')."
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "default": "en",
      "description": "BCP-47 source locale for i18n/<locale>.json files."
    },

    "container": { "$ref": "#/$defs/container" },
    "volumes":   { "type": "array", "items": { "$ref": "#/$defs/volume" } },
    "features":  { "$ref": "#/$defs/features" }
  },

  "$defs": {
    "translatableString": {
      "type": "string",
      "minLength": 1,
      "description": "Either a literal string or 't:<key>' resolved from i18n/<locale>.json."
    },

    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image"],
      "properties": {
        "image": {
          "type": "string",
          "minLength": 1,
          "description": "OCI image reference (e.g. 'lscr.io/linuxserver/steam:latest')."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "volume": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "hostPath", "containerPath", "mode"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "label": { "$ref": "#/$defs/translatableString" },
        "scope": { "enum": ["shared", "perUser"] },
        "hostPath": {
          "type": "string",
          "minLength": 1,
          "description": "Host path. For scope=perUser, Wisp appends a per-user subdir at session start."
        },
        "containerPath": { "type": "string", "pattern": "^/" },
        "mode": { "enum": ["ro", "rw"] }
      }
    },

    "features": {
      "type": "object",
      "additionalProperties": { "type": "object" },
      "description": "Open feature map. Known features are typed below; unknown features pass through and emit a warning at load time.",
      "properties": {
        "shortcuts": { "$ref": "#/$defs/featureShortcuts" }
      }
    },

    "featureShortcuts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "containerPath"],
      "properties": {
        "provider": {
          "type": "string",
          "description": "Provider id (e.g. 'steam', 'heroic'). Unknown values disable the feature with a warning."
        },
        "containerPath": { "type": "string", "pattern": "^/" }
      }
    }
  }
}
