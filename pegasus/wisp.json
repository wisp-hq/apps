{
  "$schema": "../wisp.schema.json",
  "schemaVersion": 1,
  "slug": "pegasus",
  "version": "1.0.0",
  "name": "Pegasus",
  "description": "t:description",
  "icon": "icon.svg",
  "container": {
    "image": "ghcr.io/wisp-hq/pegasus:latest",
    "env": { "TZ": "Europe/Paris" }
  },
  "volumes": [
    {
      "id": "config",
      "label": "t:volumes.config.label",
      "scope": "perUser",
      "hostPath": "pegasus",
      "containerPath": "/config",
      "mode": "rw"
    },
    {
      "id": "roms",
      "label": "t:volumes.roms.label",
      "scope": "shared",
      "hostPath": "/data/shared/roms",
      "containerPath": "/config/roms",
      "mode": "ro"
    }
  ]
}
